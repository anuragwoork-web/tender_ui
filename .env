# Local development. Vite loads this for `npm run dev`.
#
# One variable holds the whole backend address, so changing where the API lives
# is a one-line edit here — nothing in src/ carries a port or a host.
#
# Tender's backend runs on 8003 locally; bid_managment owns 8000, so the two can
# run side by side.
VITE_API_URL=http://localhost:8003

# Demoing to a phone or another machine on the same network? Point this at the
# laptop's LAN address instead (find it with `ipconfig`), and start the backend
# with run_server.bat so it binds 0.0.0.0:
# VITE_API_URL=http://172.20.10.2:8003
