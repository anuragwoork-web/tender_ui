# Copy to .env (local) or .env.production (deployed) and set the one variable.
#
# Which file Vite reads is decided by the command, not by anything you switch:
#   npm run dev     -> .env
#   npm run build   -> .env.production
#
# VITE_API_URL is the whole base URL of the Tender backend. Full URL rather than
# a port so both deployment shapes fit the same variable:
#
#   local           http://localhost:8003
#   LAN demo        http://172.20.10.2:8003
#   behind a domain https://api.example.com
#   host and port   http://203.0.113.10:8003
#
# Nothing under src/ contains a host or a port; this is the only place to change.
VITE_API_URL=http://localhost:8003

# Optional. Only used if VITE_API_URL is unset, when the app falls back to the
# host the page was served from. Leave it alone unless the backend moves off
# 8003.
# VITE_API_PORT=8003
