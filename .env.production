# Production. Vite loads this for `npm run build` — no flag, no manual switch;
# the dev values in .env are simply not used by a build.
#
# Set this to wherever the deployed backend answers. Both shapes work, because
# the variable is a full base URL rather than a port:
#
#   behind a domain   VITE_API_URL=https://api.example.com
#   host and port     VITE_API_URL=http://203.0.113.10:8003
#
# It is read at build time, not at runtime, so changing it means rebuilding.
#
# HTTPS note: a page served over https cannot call an http API — the browser
# blocks it as mixed content. If the site is https, this has to be too.
VITE_API_URL=https://api.example.com
